{
  "openapi": "3.0.3",
  "info": {
    "title": "ReadArena Mobile API",
    "version": "1.0.0",
    "description": "API endpoints for the ReadArena Android application"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentication endpoints" },
    { "name": "Profile", "description": "Profile management" },
    { "name": "Books", "description": "Book listing and details" },
    { "name": "Reading", "description": "Reading progress sync" },
    { "name": "Quizzes", "description": "Quiz submission" }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new mobile user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration was successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthRegisterResponse" }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate a mobile user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": ["Profile"],
        "summary": "Get the authenticated user's profile",
        "security": [
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          }
        }
      }
    },
    "/api/profile/photo": {
      "post": {
        "tags": ["Profile"],
        "summary": "Upload a profile photo",
        "security": [
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePhotoUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile photo uploaded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfilePhotoResponse" }
              }
            }
          }
        }
      }
    },
    "/api/books": {
      "get": {
        "tags": ["Books"],
        "summary": "List all published books",
        "security": [
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Books retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BooksResponse" }
              }
            }
          }
        }
      }
    },
    "/api/books/{book}": {
      "get": {
        "tags": ["Books"],
        "summary": "Get a single book with its quizzes",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "book",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Book ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Book retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookDetailResponse" }
              }
            }
          }
        }
      }
    },
    "/api/books/{book}/progress": {
      "post": {
        "tags": ["Reading"],
        "summary": "Sync reading progress for a book",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "book",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Book ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProgressSyncRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Progress synced successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProgressSyncResponse" }
              }
            }
          }
        }
      }
    },
    "/api/quizzes/{quiz}/submit": {
      "post": {
        "tags": ["Quizzes"],
        "summary": "Submit answers for a quiz",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "quiz",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Quiz ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuizSubmissionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quiz submitted successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/QuizSubmissionResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password", "password_confirmation"],
        "properties": {
          "name": { "type": "string", "example": "Android User" },
          "email": { "type": "string", "format": "email", "example": "android@example.com" },
          "password": { "type": "string", "format": "password", "example": "password123" },
          "password_confirmation": { "type": "string", "format": "password", "example": "password123" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "android@example.com" },
          "password": { "type": "string", "format": "password", "example": "password123" }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "AuthRegisterResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "user": { "$ref": "#/components/schemas/UserSummary" },
          "token": { "type": "string" }
        }
      },
      "AuthLoginResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "user": { "$ref": "#/components/schemas/UserSummary" },
          "token": { "type": "string" }
        }
      },
      "ProfileData": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" },
          "profile_photo_url": { "type": ["string", "null"] }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ProfileData" }
        }
      },
      "ProfilePhotoUploadRequest": {
        "type": "object",
        "required": ["profile_photo"],
        "properties": {
          "profile_photo": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "ProfilePhotoResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "profile_photo_url": { "type": "string" }
            }
          }
        }
      },
      "BookSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "cover_image": { "type": ["string", "null"] },
          "authors": { "type": "array", "items": { "type": "string" } },
          "genres": { "type": "array", "items": { "type": "string" } },
          "publisher": { "type": ["string", "null"] },
          "publication_year": { "type": "integer" },
          "status": { "type": "string" }
        }
      },
      "BooksResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BookSummary" }
          }
        }
      },
      "QuizAnswerSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "body": { "type": "string" }
        }
      },
      "QuestionSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "prompt": { "type": "string" },
          "points": { "type": "integer" },
          "answers": { "type": "array", "items": { "$ref": "#/components/schemas/QuizAnswerSchema" } }
        }
      },
      "QuizSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "instructions": { "type": "string" },
          "pass_mark": { "type": "integer" },
          "attempt_limit": { "type": "integer" },
          "duration_minutes": { "type": "integer" },
          "questions": { "type": "array", "items": { "$ref": "#/components/schemas/QuestionSchema" } }
        }
      },
      "BookDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "title": { "type": "string" },
              "slug": { "type": "string" },
              "description": { "type": "string" },
              "cover_image": { "type": ["string", "null"] },
              "authors": { "type": "array", "items": { "type": "string" } },
              "genres": { "type": "array", "items": { "type": "string" } },
              "publisher": { "type": ["string", "null"] },
              "publication_year": { "type": "integer" },
              "page_count": { "type": "integer" },
              "language": { "type": "string" },
              "isbn": { "type": "string" },
              "status": { "type": "string" },
              "quizzes": { "type": "array", "items": { "$ref": "#/components/schemas/QuizSchema" } }
            }
          }
        }
      },
      "ProgressSyncRequest": {
        "type": "object",
        "required": ["current_page"],
        "properties": {
          "current_page": { "type": "integer", "example": 25 }
        }
      },
      "ProgressSyncResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "book_id": { "type": "integer" },
              "current_page": { "type": "integer" },
              "pages_read_total": { "type": "integer" }
            }
          }
        }
      },
      "QuizSubmissionRequest": {
        "type": "object",
        "required": ["answers"],
        "properties": {
          "answers": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "example": { "1": 3 }
          }
        }
      },
      "QuizSubmissionResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "score": { "type": "integer" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
